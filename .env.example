# ─────────────────────────────────────────────────────────────────────────────
#  Пример переменных окружения. Реальный .env генерируется автоматически
#  скриптом ./deploy.sh и в git НЕ попадает (см. .gitignore).
#
#  Руками сюда лезть не обязательно: всё, что ниже, deploy.sh заполнит сам.
#  Переопределять имеет смысл только SERVER_HOST / REALITY_SNI / REALITY_DEST /
#  LISTEN_PORT — остальное это секреты, которые должны быть случайными.
# ─────────────────────────────────────────────────────────────────────────────

# Версия ядра Xray (образ ghcr.io/xtls/xray-core:<tag>). Пин ради воспроизводимости.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.11.9

# Публичный адрес сервера (IP или домен). Пусто -> deploy.sh определит внешний IP сам.
SERVER_HOST=

# Публичный порт, на котором клиенты стучатся в сервер. 443 — настоятельно рекомендуется:
# Reality на не-443 порту повышает шанс, что IP приметит DPI.
LISTEN_PORT=443

# Домен-«донор» для маскировки Reality.
#   REALITY_SNI  — имя, которое уходит в ClientHello (его видит DPI, оно должно
#                  выглядеть как обычный поход на крупный легитимный сайт).
#   REALITY_DEST — куда сервер реально ходит за TLS-рукопожатием и куда
#                  переадресует «чужой» трафик (активное зондирование).
# Требования к домену: TLS 1.3 + HTTP/2, сайт не ваш, не на том же IP, в идеале —
# в той же ASN/подсети, что и ваш VPS. Проверить: ./scripts/check-dest.sh <домен>
REALITY_SNI=www.nvidia.com
REALITY_DEST=www.nvidia.com:443

# ─── Секреты (генерируются; руками не трогать) ──────────────────────────────
UUID=
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
SHORT_ID=
